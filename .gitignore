# Obsidian workspace files (these change frequently and are device-specific, causing most conflicts)
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspace-mobile
.obsidian/workspace-mobile.json

# Obsidian graph view state (changes when you move nodes around)
.obsidian/graph.json

# Obsidian Trash folder
.trash/

# System generated files
.DS_Store
Thumbs.db
desktop.ini

# Node modules (just in case you run npm install again)
node_modules/

# Python caches and virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Editor and IDE directories
.vscode/
.idea/
*.swp
*.bak

# Temporary processing scripts and output files
extract_*.js
split_pdf.js
temp_*.txt
temp_*.pdf

# Node package files (from temporary script installations)
package.json
package-lock.json

